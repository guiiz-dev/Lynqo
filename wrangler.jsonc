{
  "name": "lynqo",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "lynqo-db", "database_id": "COLE-AQUI-O-ID-DO-BANCO" }
  ],
  "vars": { "ANTHROPIC_MODEL": "claude-haiku-5-5", "DAILY_LIMIT": "500" }
}
